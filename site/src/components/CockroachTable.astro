---
// CockroachTable.astro
// Renders a terminal-styled view of CockroachDB canonization_events query output.
interface Row {
  node_id: string;
  concept_name?: string;
  from_status: string;
  to_status: string;
  blast_radius: number | null;
  occurred_at: string;
}

interface Props {
  title?: string;
  query?: string;
  cluster?: string;
  database?: string;
  rows?: Row[];
}

const {
  title = "CockroachDB Cloud — SQL Query Output",
  query = "SELECT node_id, from_status, to_status, blast_radius, occurred_at FROM canonization_events ORDER BY occurred_at;",
  cluster = "nrynss-19495 (CockroachDB Cloud)",
  database = "lambo",
  rows = [
    {
      node_id: "724c92b9-a8a0-4d58-aa2e-29ed3cc43a57",
      concept_name: "user schema",
      from_status: "None",
      to_status: "Candidate",
      blast_radius: null,
      occurred_at: "2026-08-15T14:50:08.306Z"
    },
    {
      node_id: "3e3a6984-3bd6-480d-8490-d9df9b03540a",
      concept_name: "add oauth_id to user schema",
      from_status: "None",
      to_status: "Candidate",
      blast_radius: null,
      occurred_at: "2026-08-15T14:50:08.306Z"
    },
    {
      node_id: "724c92b9-a8a0-4d58-aa2e-29ed3cc43a57",
      concept_name: "user schema",
      from_status: "Candidate",
      to_status: "Venerable",
      blast_radius: null,
      occurred_at: "2026-08-15T14:50:08.992Z"
    },
    {
      node_id: "724c92b9-a8a0-4d58-aa2e-29ed3cc43a57",
      concept_name: "user schema",
      from_status: "Venerable",
      to_status: "Canonical",
      blast_radius: 9,
      occurred_at: "2026-08-15T14:50:09.600Z"
    },
    {
      node_id: "1848c6e5-8b63-4a64-942e-76c75afd0ce1",
      concept_name: "add rate limiting middleware",
      from_status: "None",
      to_status: "Candidate",
      blast_radius: null,
      occurred_at: "2026-08-15T14:50:10.103Z"
    }
  ]
} = Astro.props;
---

<div class="crdb-window">
  <div class="crdb-header">
    <div class="crdb-dots" aria-hidden="true">
      <span class="dot dot-red"></span>
      <span class="dot dot-yellow"></span>
      <span class="dot dot-green"></span>
    </div>
    <div class="crdb-title">{title}</div>
    <div class="crdb-cluster-badge">{cluster} | db: {database}</div>
  </div>

  <div class="crdb-query-bar">
    <span class="prompt">sql&gt;</span>
    <code>{query}</code>
  </div>

  <div class="crdb-table-wrapper">
    <table class="crdb-table">
      <thead>
        <tr>
          <th>node_id</th>
          <th>concept</th>
          <th>from_status</th>
          <th>to_status</th>
          <th>blast_radius</th>
          <th>occurred_at</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class={row.to_status === 'Canonical' ? 'row-canonical' : ''}>
            <td class="cell-mono cell-dim">{row.node_id.slice(0, 8)}…</td>
            <td class="cell-concept">
              <code>{row.concept_name}</code>
            </td>
            <td>
              <span class={`status-pill status-${row.from_status.toLowerCase()}`}>
                {row.from_status}
              </span>
            </td>
            <td>
              <span class={`status-pill status-${row.to_status.toLowerCase()}`}>
                {row.to_status}
              </span>
            </td>
            <td class="cell-num">
              {row.blast_radius !== null ? (
                <span class="blast-badge">⚑ {row.blast_radius}</span>
              ) : (
                <span class="cell-dim">null</span>
              )}
            </td>
            <td class="cell-mono cell-dim">{row.occurred_at}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="crdb-footer">
    <span>({rows.length} rows)</span>
    <span class="crdb-verified">Verified via CockroachDB Cloud Managed MCP Server</span>
  </div>
</div>

<style>
  .crdb-window {
    background: #0d1310;
    border: 1px solid #223029;
    border-radius: 0.6rem;
    margin: 1.5rem 0;
    overflow: hidden;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    box-shadow: var(--lambo-shadow-md);
  }

  .crdb-header {
    background: #131b17;
    padding: 0.55rem 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #223029;
  }

  .crdb-dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
    opacity: 0.85;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #22c55e; }

  .crdb-title {
    color: #a9b8af;
    font-size: 0.74rem;
    font-weight: 500;
  }

  .crdb-cluster-badge {
    color: #86efac;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.25);
    padding: 0.14rem 0.45rem;
    border-radius: 0.3rem;
    font-size: 0.69rem;
  }

  .crdb-query-bar {
    background: #0f1613;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid #223029;
    color: #e4ede7;
    display: flex;
    gap: 0.55rem;
    align-items: center;
    overflow-x: auto;
  }

  .crdb-query-bar code {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    color: inherit !important;
    font-size: 0.78rem !important;
  }

  .prompt {
    color: #22c55e;
    font-weight: 600;
    user-select: none;
  }

  .crdb-table-wrapper {
    overflow-x: auto;
  }

  .crdb-table {
    display: table !important;
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
  }

  .crdb-table thead {
    background: #131b17 !important;
  }

  .crdb-table th {
    background: #131b17;
    color: #8da196;
    font-weight: 600;
    font-size: 0.71rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid #223029;
  }

  .crdb-table td {
    padding: 0.52rem 0.8rem;
    border-bottom: 1px solid #19241e;
    color: #d4ddd7;
    white-space: nowrap;
  }

  .crdb-table tbody tr:hover td {
    background: rgba(34, 197, 94, 0.05);
  }

  .row-canonical td {
    background: rgba(245, 158, 11, 0.065);
  }

  .cell-mono {
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }

  .cell-dim {
    color: #7c9085;
  }

  .cell-concept code {
    color: #86efac !important;
    background: rgba(34, 197, 94, 0.1) !important;
    border: 1px solid rgba(34, 197, 94, 0.18) !important;
    padding: 0.1rem 0.35rem !important;
    border-radius: 0.25rem !important;
    font-size: 0.76rem !important;
  }

  .status-pill {
    padding: 0.14rem 0.42rem;
    border-radius: 0.25rem;
    font-size: 0.71rem;
    font-weight: 500;
  }

  .status-none { color: #8da196; background: rgba(141, 161, 150, 0.14); }
  .status-candidate { color: #60a5fa; background: rgba(96, 165, 250, 0.14); }
  .status-venerable { color: #34d399; background: rgba(52, 211, 153, 0.14); }
  .status-canonical { color: #fbbf24; background: rgba(251, 191, 36, 0.18); font-weight: 600; }

  .blast-badge {
    color: #fbbf24;
    font-weight: 600;
    background: rgba(251, 191, 36, 0.14);
    padding: 0.14rem 0.45rem;
    border-radius: 0.25rem;
  }

  .crdb-footer {
    padding: 0.48rem 0.9rem;
    background: #101714;
    border-top: 1px solid #223029;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: space-between;
    font-size: 0.72rem;
    color: #7c9085;
  }

  .crdb-verified {
    color: #4ade80;
  }
</style>
