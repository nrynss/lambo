/-
# Oracle vectors for `BatchQueue/Pure.lean`

`BatchQueue.lengthChunks Cfg.rust` (`FORWARD_WIDTH = 8`,
`CHUNK_SLACK_BYTES = 64`) over generated byte lengths, against
`length_chunks` in `src/embed/candle.rs`. Nothing is left abstract: the
model's input is the list of lengths, its output the chunks of indices.
Lengths cluster around each other's thresholds (`2 · shortest + slack`,
one either side) and repeat, so the stable sort's tie order matters.
-/
import LamboProofs.BatchQueue.Runs
import OracleExport.Gen

namespace Lambo.Oracle.BatchQueue

open Lean Lambo.BatchQueue Lambo.Oracle

def genLens : Gen (List Nat) := do
  let n ← pick [0, 1, 2, 3, 5, 8, 9, 12, 16, 17, 24, 32]
  let base ← many (← range 1 3) (pick [0, 1, 10, 40, 84, 100, 300])
  many n (do
    let b ← pick base
    match ← below 6 with
    | 0 => return 2 * b + Cfg.rust.slack
    | 1 => return 2 * b + Cfg.rust.slack + 1
    | 2 => return b
    | 3 => range 0 1000
    | _ => return b + (← below 5))

def seed : UInt64 := 0x4241544348 -- "BATCH"

def vectors : Vectors := run seed do
  let lens ← many 200 genLens
  return {
    model := "BatchQueue", file := some "BatchQueue/Pure.lean", seed
    notes := [
      "lengthChunks with Cfg.rust (FORWARD_WIDTH 8, CHUNK_SLACK_BYTES 64). Input: byte lengths; output: chunks of indices into them.",
      "The Rust side needs feature embed-candle; without it the test only checks the file."
    ]
    fns := [
      { lean := "Lambo.BatchQueue.lengthChunks", rust := "embed::candle::length_chunks",
        cases := lens.map fun l => case (toJson l) (toJson (lengthChunks Cfg.rust l)) }
    ]
  }

end Lambo.Oracle.BatchQueue
