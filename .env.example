# Copy to .env and fill in. Never commit .env.
# Prefer lambo.toml for non-secret process config (see lambo.example.toml).
# Level B: Cargo features compile adapters; env/TOML select among them.
#   dev-diary/notes/level-b-pluggability.md

# Store selection: memory | cockroach | sqlite  (must be compiled in)
# LAMBO_STORE=memory
# Optional path to process config:
# LAMBO_CONFIG=./lambo.toml

# CockroachDB Cloud (sqlx / psql) — used when LAMBO_STORE=cockroach
# Prefer sslrootcert=system with sslmode=verify-full (libpq / sqlx on Linux).
LAMBO_COCKROACH_DSN=postgresql://USER:PASSWORD@HOST:26257/lambo?sslmode=verify-full&sslrootcert=system
LAMBO_COCKROACH_CLUSTER=nrynss
LAMBO_COCKROACH_HOST=
LAMBO_COCKROACH_PORT=26257
LAMBO_COCKROACH_USER=
LAMBO_COCKROACH_PASSWORD=
LAMBO_COCKROACH_DATABASE=lambo

# ---------------------------------------------------------------------------
# Embeddings (portable) — see dev-diary/notes/embeddings-portable.md
# Dense embeddings, L2-normalized. embedder.dim is expected width (default 1024 for BGE).
# Store schema (e.g. Cockroach VECTOR(n)) is the authority when vectors are persisted —
# see GraphStore::vector_dimensions + resolve_backends. Do not mix models mid-session.
# ---------------------------------------------------------------------------
# bge_m3 (default) | bedrock | fixture
LAMBO_EMBEDDER=bge_m3
LAMBO_EMBED_DIM=1024

# BGE-M3 via llama.cpp (HF download + local server)
LAMBO_LLAMA_EMBED_URL=http://127.0.0.1:8080
# Model id sent to the /v1/embeddings request (empty => llama.cpp default model).
# NOTE: only LAMBO_LLAMA_MODEL feeds the HTTP request. LAMBO_BGE_M3_MODEL is the
# local GGUF *filesystem path* for the scripts and is NEVER sent over HTTP.
# LAMBO_LLAMA_MODEL=bge-m3-FP16
# GGUF filesystem path used by run-llama-embed.sh (not the HTTP model id)
# LAMBO_BGE_M3_MODEL=models/bge-m3/bge-m3-FP16.gguf
# HF repo id / gguf file / pinned revision used by fetch scripts
# LAMBO_BGE_M3_HF_REPO=gpustack/bge-m3-GGUF
# LAMBO_BGE_M3_GGUF=bge-m3-FP16.gguf
# LAMBO_BGE_M3_REVISION=2d48f1737679ad900d5c26c5aad5410e9c70fdca

# Bedrock Titan V2 — only when account authorizationStatus is AUTHORIZED
# LAMBO_EMBEDDER=bedrock
AWS_REGION=ap-south-2
LAMBO_BEDROCK_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=bedrock-api-key-...
# LAMBO_BEDROCK_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
